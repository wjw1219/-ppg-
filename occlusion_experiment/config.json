{
  "data_dir": "data",
  "cohort_file": "cohort.csv",
  "weekly_file": "ppg_weekly.csv",
  "id_column": "patient_id",
  "label_column": "label",
  "week_column": "week",
  "clinical_columns": [],
  "ppg_columns": [],
  "n_weeks": 26,
  "n_splits": 5,
  "inner_val_fraction": 0.2,
  "seeds": [2026, 2027, 2028],
  "hidden_dim": 64,
  "num_heads": 4,
  "num_layers": 2,
  "dropout": 0.30,
  "optimizer": "AdamW",
  "learning_rate": 0.001,
  "weight_decay": 0.0001,
  "batch_size": 16,
  "max_epochs": 200,
  "early_stopping_patience": 20,
  "threshold_mode": "validation_youden",
  "fixed_threshold": 0.5,
  "bootstrap_reps": 2000,
  "add_clinical_missing_indicators": true,
  "output_dir": "outputs/single_week_occlusion"
}
